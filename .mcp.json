{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "./app/data"
      ]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.7.4"],
      "env": {
        "MEMORY_FILE_PATH": "./.mcp-memory/ws06-graph.json"
      }
    },
    "catalog": {
      "command": "node",
      "args": ["./mcp-server/dist/server.js"]
    }
  }
}
