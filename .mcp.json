{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "./app/data"
      ]
    },
    "memory": {
      "command": "node",
      "args": ["./scripts/memory-server.mjs"]
    },
    "catalog": {
      "command": "node",
      "args": ["./mcp-server/dist/server.js"]
    }
  }
}
